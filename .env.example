# Copy to .env.local for local dev, and set the same three in
# Vercel → Project → Settings → Environment Variables for production.
#
# These are read only by the serverless function in api/submit.js. They are
# never bundled into the client — do not prefix them with VITE_, or Vite will
# inline the API key into the public JavaScript.

# SendGrid API key, restricted to "Mail Send" permission only.
SENDGRID_API_KEY=

# Where form submissions are delivered.
FORM_TO_EMAIL=info@danceacademywest.com

# Sender address. Must be a verified sender in SendGrid — either Single Sender
# Verification or full domain authentication on danceacademywest.com.
# SendGrid returns 403 on send if this address is not verified.
FORM_FROM_EMAIL=website@danceacademywest.com
